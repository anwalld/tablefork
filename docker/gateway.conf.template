worker_processes auto;
error_log /dev/stderr notice;
pid /var/run/nginx.pid;
events { worker_connections 1024; }
stream {
    resolver 127.0.0.11 valid=5s;
    log_format connection '$remote_addr $status $bytes_sent $bytes_received';
    access_log /dev/stdout connection;
    limit_conn_zone $binary_remote_addr zone=perip:10m;
    limit_conn perip ${GATEWAY_CONN_PER_IP};
    upstream web_http {
        zone web_http 64k;
        hash $remote_addr consistent;
        server web-1:80 resolve max_fails=1 fail_timeout=5s;
        server web-2:80 resolve max_fails=1 fail_timeout=5s;
    }
    upstream web_https {
        zone web_https 64k;
        hash $remote_addr consistent;
        server web-1:443 resolve max_fails=1 fail_timeout=5s;
        server web-2:443 resolve max_fails=1 fail_timeout=5s;
    }
    proxy_protocol on;
    proxy_connect_timeout 2s;
    proxy_next_upstream on;
    server { listen 80; proxy_pass web_http; }
    server { listen 443; proxy_pass web_https; }
}
