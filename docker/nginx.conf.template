map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Login and registration attempts per client address. A single keep-alive
# connection can carry many requests, so this has to be counted per request at
# L7 rather than per connection at L4.
limit_req_zone $binary_remote_addr zone=auth:10m rate=${AUTH_RATE};
limit_req_status 429;

server {
    listen 80;

    # Resolve at request time, so a recreated app container with a new address
    # is picked up without restarting Nginx.
    resolver 127.0.0.11 valid=5s;
    set $app http://app:8000;

    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth burst=${AUTH_BURST} nodelay;
        error_page 429 = @rate_limited;
        proxy_pass $app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass $app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # AUTH_RETRY_AFTER is the time one new attempt takes to accrue at
    # AUTH_RATE, so clients know how long to wait.
    location @rate_limited {
        default_type application/json;
        charset utf-8;
        add_header Retry-After ${AUTH_RETRY_AFTER} always;
        return 429 '{"error":{"code":"rate_limited","message":"尝试次数过多，请稍后再试","retryable":true,"retry_after":${AUTH_RETRY_AFTER}}}';
    }

    location = /health {
        proxy_pass $app;
    }

    location = /ws {
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
