--- a/src/sentinel.c
+++ b/src/sentinel.c
@@ -518,6 +518,22 @@
         getRandomHexChars(sentinel.myid,CONFIG_RUN_ID_SIZE);
         sentinelFlushConfig();
     }
+
+    /* Old peer addresses may have pointed back to us before this guard was
+     * installed. Remove only our own ID after all config entries are loaded,
+     * irrespective of directive order; preserve epochs, votes and real peers. */
+    int removed_self = 0;
+    sds self_id = sdsnew(sentinel.myid);
+    dictIterator *di = dictGetIterator(sentinel.masters);
+    dictEntry *de;
+    while ((de = dictNext(di)) != NULL) {
+        sentinelRedisInstance *master = dictGetVal(de);
+        if (dictDelete(master->sentinels, self_id) == DICT_OK)
+            removed_self = 1;
+    }
+    dictReleaseIterator(di);
+    sdsfree(self_id);
+    if (removed_self) sentinelFlushConfig();
 
     /* Log its ID to make debugging of issues simpler. */
     serverLog(LL_NOTICE,"Sentinel ID is %s", sentinel.myid);
@@ -2845,6 +2861,10 @@
     sentinelRedisInstance *si, *master;
 
     if (numtokens == 8) {
+        /* Both Pub/Sub and direct Sentinel PUBLISH arrive here. A stale peer
+         * address can point back to us after container IP reuse. */
+        if (!strcmp(token[2], sentinel.myid)) goto cleanup;
+
         /* Obtain a reference to the master this hello message is about */
         master = sentinelGetMasterByName(token[4]);
         if (!master) goto cleanup; /* Unknown master, skip the message. */
