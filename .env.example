# Copy to .env and replace every change-me value. .env is ignored by Git.
# Generate a password with: openssl rand -hex 24

# Required
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
REDIS_PASSWORD=change-me

# The public origins browsers load the app from, comma separated.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Set to 1 when the app is served over HTTPS.
COOKIE_SECURE=0

# Tuning. The README explains how these defaults were chosen.
WORKER_COUNT=16
WORKER_QUEUE_LIMIT=1024

# Login and registration attempts allowed per client address, enforced by Nginx.
AUTH_RATE=10r/m
AUTH_BURST=10
# Seconds a limited client is told to wait: 60 / the per-minute AUTH_RATE.
AUTH_RETRY_AFTER=6

# Login delay per user name (and per device that has logged in before): this
# many attempts are free, then the wait doubles from the base up to the max.
# A name's count is forgotten after LOGIN_FAIL_TTL_SECONDS without attempts.
LOGIN_FREE_ATTEMPTS=5
LOGIN_BACKOFF_BASE_SECONDS=1
LOGIN_BACKOFF_MAX_SECONDS=60
LOGIN_FAIL_TTL_SECONDS=900
DEVICE_TTL_DAYS=180

# Messages one user may send per window, across all connections and rooms.
MESSAGE_RATE_LIMIT=30
MESSAGE_RATE_WINDOW_SECONDS=10

# AI service. Generate the secrets with:
#   openssl rand -hex 24        (AI_GRPC_TOKEN, AI_MYSQL_PASSWORD)
#   openssl rand -base64 32     (AI_KEY_ENCRYPTION_KEY)
# AI_KEY_ENCRYPTION_KEY encrypts users' model API keys. Losing it makes every
# stored key unreadable; leaking it exposes them. Only the ai service gets it.
AI_GRPC_TOKEN=change-me
AI_MYSQL_PASSWORD=change-me
AI_KEY_ENCRYPTION_KEY=change-me

# How the AIs behave. See openspec/specs/ai-replies.
AI_CHAIN_P=0.5
AI_PROACTIVE_P1=0.5
AI_IDLE_SECONDS=1800
AI_CONTEXT_MESSAGES=30
AI_GENERATION_TIMEOUT=60

# AI recovery: total generation attempts, retry delay and worker lease.
AI_GENERATION_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=1
AI_WORK_LEASE_SECONDS=10
